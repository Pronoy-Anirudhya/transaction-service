# Copy to .env (git-ignored) to override the local-development defaults of docker-compose.yml.
# Every value below is a LOCAL DEVELOPMENT placeholder, never a real secret.

# Public API key: send it in the X-API-Key header.
API_KEY=local-dev-api-key

# HMAC-SHA256 key for quote tokens (use a long random value outside local development).
QUOTE_SIGNING_KEY=local-dev-quote-signing-key-change-me-0123456789

# PostgreSQL (database txn_db, user txn). Changing it after the first start needs
# `docker compose down -v` (the password is set when the volume is initialised).
TXN_DB_PASSWORD=txn-local-dev

# RabbitMQ user of transaction-service. The broker's users are defined in
# deploy/rabbitmq/definitions.json (txn / txn-local-dev, admin / admin-local-dev for the
# management UI); if you change these, regenerate the password_hash there (see README).
RABBIT_USER=txn
RABBIT_PASSWORD=txn-local-dev

# Spring profiles of transaction-service ("test" enables register / fund wallet).
SPRING_PROFILES_ACTIVE=test

# URL of the separately run ledger-service, as seen from the transaction-service container.
# Default: the ledger published on this host's port 8081.
# LEDGER_BASE_URL=http://host.docker.internal:8081

# Host ports
# TXN_PORT=8080
# PG_PORT=5432
# RABBIT_PORT=5672
# RABBIT_MGMT_PORT=15672

# PostgreSQL memory (spec 12: shared_buffers ~25% of RAM on the reference host)
# PG_SHARED_BUFFERS=512MB
# PG_EFFECTIVE_CACHE_SIZE=1536MB
