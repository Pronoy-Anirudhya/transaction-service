{
  "name": "ledger: POST /internal/v1/fundings -> 200 POSTED (echoes the id as postingId and fundingId)",
  "priority": 10,
  "request": {
    "method": "POST",
    "urlPath": "/internal/v1/fundings",
    "bodyPatterns": [
      { "matchesJsonPath": "$.fundingId" },
      { "matchesJsonPath": "$.accountId" }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": "{\"postingId\":\"{{jsonPath request.body '$.fundingId'}}\",\"fundingId\":\"{{jsonPath request.body '$.fundingId'}}\",\"status\":\"POSTED\",\"replay\":false,\"timestamp\":{{now format='epoch'}}000000}"
  }
}
