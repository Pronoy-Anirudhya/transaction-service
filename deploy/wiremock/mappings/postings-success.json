{
  "name": "ledger: POST /internal/v1/postings -> 200 POSTED (default)",
  "priority": 10,
  "request": {
    "method": "POST",
    "urlPath": "/internal/v1/postings",
    "bodyPatterns": [
      { "matchesJsonPath": "$.postingId" },
      { "matchesJsonPath": "$.legs[0]" }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": "{\"postingId\":\"{{jsonPath request.body '$.postingId'}}\",\"status\":\"POSTED\",\"replay\":false,\"timestamp\":{{now format='epoch'}}000000}"
  }
}
